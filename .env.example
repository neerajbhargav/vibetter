# VIBETTER settings. Copy to ~/.vibetter/.env (the installer writes it for you).
# Real environment variables override this file. The project's own .env is never read.

# Provider: gemini | openai | anthropic | ollama. Auto-detected from the API key if unset.
# VIBETTER_PROVIDER=gemini

# API key for your provider (only the one you use)
# Gemini:    https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
# OpenAI:    https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_key_here
# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_key_here

# Ollama runs locally and needs no key. Default host:
# OLLAMA_HOST=http://127.0.0.1:11434

# Try this model before the provider's default chain
# VIBETTER_MODEL=qwen2.5-coder:7b

# Codebase to index. Unset: the directory the IDE starts the server in.
# VIBETTER_CODEBASE_PATH=/path/to/your/project

# Remove sentences whose citation fails to check (the tools also take strict=true)
# VIBETTER_STRICT=1

# Dense retrieval arm: pip install 'vibetter[dense]', then set this. Off by default,
# because it lowered recall in the eval (eval/README.md).
# VIBETTER_DENSE=1

# Ollama context window in tokens. Default: sized to fit each prompt (8192 to 32768).
# VIBETTER_OLLAMA_NUM_CTX=16384

# One JSON line per tool call in ~/.vibetter/traces.jsonl. Set 0 to turn it off.
# VIBETTER_TRACE=0
# Also export OpenTelemetry spans (pip install 'vibetter[otel]'; uses OTEL_EXPORTER_OTLP_*)
# VIBETTER_OTEL=1
